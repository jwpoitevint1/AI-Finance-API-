import os
import requests

# Optional: configure endpoint via environment variable
MODEL_ENDPOINT = os.getenv("MODEL_ENDPOINT", "http://localhost:5000/generate")

def call_llama(prompt: str) -> str:
    """
    Send a prompt to your model and return the response.
    Replace the stub below with actual inference logic.
    """
    try:
        # Example: if you expose a FastAPI route for inference
        resp = requests.post(MODEL_ENDPOINT, json={"prompt": prompt}, timeout=30)
        resp.raise_for_status()
        data = resp.json()
        return data.get("text", "")
    except Exception as e:
        # Fail-safe: return an error string so governance can handle it
        return f"Error calling model: {str(e)}"
